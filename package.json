{
	"name": "breaker-box",
	"version": "10.0.2",
	"description": "A zero-dependency circuit breaker implementation for Node.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirlancelot/breaker-box.git"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pkgroll --clean-dist --src lib --target=node22 --sourcemap --env.NODE_ENV=production",
		"dev": "vitest dev --update",
		"format": "prettier --cache --write .",
		"lint": "eslint . --fix",
		"postversion": "git push --follow-tags",
		"prepublishOnly": "node scripts/prepublish.mjs",
		"preversion": "npm run test",
		"reinstall": "rm -rf node_modules package-lock.json && npm install",
		"test": "vitest --run --typecheck",
		"test:coverage": "vitest --run --coverage",
		"type-check": "tsc --noEmit",
		"version": "node scripts/version.mjs"
	},
	"keywords": [
		"async",
		"fallback",
		"fault-tolerance",
		"reliability",
		"try-again"
	],
	"author": "Matthew Pietz <sirlancelot@gmail.com>",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@eslint/json": "2.1.0",
		"@eslint/markdown": "8.0.3",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "10.11.0",
		"pkgroll": "2.28.1",
		"prettier": "3.9.9",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1",
		"vitest": "5.0.1",
		"vitest-when": "1.0.0",
		"zx": "8.8.5"
	}
}
