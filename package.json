{
	"name": "breaker-box",
	"version": "9.0.0",
	"description": "A zero-dependency circuit breaker implementation for Node.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirlancelot/breaker-box.git"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pkgroll --clean-dist --src lib --target=node22 --sourcemap --env.NODE_ENV=production",
		"dev": "vitest dev --update",
		"format": "prettier --cache --write .",
		"lint": "eslint . --fix",
		"prepublishOnly": "npm run test && npm run build",
		"reinstall": "rm -rf node_modules package-lock.json && npm install",
		"test": "vitest --run --typecheck",
		"test:coverage": "vitest --run --coverage",
		"type-check": "tsc --noEmit"
	},
	"keywords": [
		"async",
		"fallback",
		"fault-tolerance",
		"reliability",
		"try-again"
	],
	"author": "Matthew Pietz <sirlancelot@gmail.com>",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@eslint/json": "2.0.0",
		"@eslint/markdown": "8.0.2",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.7",
		"eslint": "10.4.1",
		"pkgroll": "2.27.1",
		"prettier": "3.8.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.0",
		"vitest": "4.1.7",
		"vitest-when": "0.10.0"
	},
	"overrides": {
		"pkgroll@2.27.1": {
			"typescript": "$typescript"
		}
	}
}
